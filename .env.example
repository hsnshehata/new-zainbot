NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000

# Required in every deployed environment. Use a random value of at least 32 bytes.
JWT_SECRET=

# Use one canonical database URI. MONGO_URI is accepted temporarily for legacy compatibility.
MONGODB_URI=
MONGO_URI=

# Encrypts provider and channel credentials at rest.
# Format: base64:<32-byte-key> or hex:<64-hex-characters>
CREDENTIAL_ENCRYPTION_KEY=

OPENAI_API_KEY=
GOOGLE_CLIENT_ID=

EMAIL_USER=
EMAIL_PASS=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_GRAPH_API_VERSION=v24.0
INSTAGRAM_APP_SECRET=
WHATSAPP_APP_SECRET=
# One shared random verification token is enough, or set channel-specific values.
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

IMGBB_API_KEY=
LEMONFOX_API_KEY=
METRICS_TOKEN=

DEBUG=false
